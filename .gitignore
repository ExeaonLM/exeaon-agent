# i18n translation files make by script using `make build`
public/locales/**/*
src/i18n/declaration.ts
.env
.envrc
node_modules/
build/
logs/
/.tmp/live-e2e-state/
# Scratch space for local E2E runs. Ignore the whole directory: besides the
# mock-llm state dirs, the suite also drops an automation DB and an unignored
# `secrets.json` here, which should never be committable.
/.tmp/
dist/
__pycache__


/test-results/
/test-results-live/
/test-results-mock-llm/
/test-results-mock-llm-docker/
/.mock-llm-markers/
/playwright-report/
/playwright-report-live/
/playwright-report-mock-llm/
/playwright-report-mock-llm-docker/
/blob-report/
/playwright/.cache/
/.stryker-tmp/
/reports/
.react-router/
ralph/
.vercel
*.tgz

# Local runtime artifacts produced by static-server / agent-server runs
workspace/
build-fresh/

# Electron desktop build outputs
/dist-electron/
# Downloaded uv binary (populated by `npm run download-uv` before packaging)
/resources/bin/
# Downloaded Node.js distribution (populated by `npm run download-node` before packaging)
/resources/node/

# Tauri bundled runtimes (python-runtime + llama, populated at build time; far
# too large for git — mirrors the Electron /resources/ excludes above).
# Ignore the direct children (so the multi-GB runtimes stay out of git)...
/src-tauri/resources/*
# ...but DO track the hand-authored MCP + subagent SOURCES: small, not
# regenerable, and losing them on a fresh clone would mean rewriting them.
# The heavy MCP payloads (bin/, cyber-unified/, iverilog/, the .exe) stay
# ignored via the /mcp/* re-exclude below.
!/src-tauri/resources/subagents/
!/src-tauri/resources/mcp/
/src-tauri/resources/mcp/*
!/src-tauri/resources/mcp/research-mcp/
!/src-tauri/resources/mcp/scholar-mcp/
!/src-tauri/resources/mcp/academic-research/
!/src-tauri/resources/mcp/mujoco-sim/
!/src-tauri/resources/mcp/rtl-sim/
!/src-tauri/resources/mcp/cyborg-sim/
!/src-tauri/resources/mcp/caldera-mcp/
!/src-tauri/resources/mcp/cyber-tools.json
# Never track compiled Python or caches even inside the tracked source dirs.
**/__pycache__/
*.pyc

# Build logs & incremental caches
tauri-build.log
/tsconfig.tsbuildinfo

# local dev
.env
vendor/
run-build.bat
schtasks-create.bat
start-build.ps1
