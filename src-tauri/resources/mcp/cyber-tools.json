{
  "$schema": "exeaon-cyber-tools/v1",
  "description": "Install recipes + policy for the cyber-unified MCP's underlying CLI tools. The Exeaon cyber agent consults this to install a missing tool through a LEGITIMATE channel before falling back. Tiers: bundled (ship in mcp/bin), ondemand (install on first use), api (needs an API key, no binary), commercial (licensed, user provides), implant (never bundle, isolated lab only).",
  "policy": {
    "installOrder": ["mcp/bin (bundled)", "winget", "choco", "scoop", "official GitHub release / go install / pip / gem", "native equivalent (note substitution)"],
    "never": ["cracked / pirated binaries", "untrusted mirrors", "bundling commercial or implant tooling into the installer"],
    "verify": "run `<tool> --version` (or -V/-h) before relying on it"
  },
  "tools": {
    "nmap": { "tier": "ondemand", "winget": "Insecure.Nmap", "choco": "nmap", "note": "SYN scans need the Npcap driver (admin). TCP-connect works without it.", "verify": "nmap --version", "license": "NPSL" },
    "masscan": { "tier": "ondemand", "choco": "masscan", "source": "https://github.com/robertdavidgraham/masscan", "note": "needs WinPcap/Npcap", "license": "AGPL-3.0" },
    "httpx": { "tier": "bundled", "go": "github.com/projectdiscovery/httpx/cmd/httpx@latest", "source": "https://github.com/projectdiscovery/httpx/releases", "verify": "httpx -version", "license": "MIT" },
    "nuclei": { "tier": "bundled", "go": "github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest", "source": "https://github.com/projectdiscovery/nuclei/releases", "verify": "nuclei -version", "license": "MIT" },
    "subfinder": { "tier": "bundled", "go": "github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest", "source": "https://github.com/projectdiscovery/subfinder/releases", "license": "MIT" },
    "dnsx": { "tier": "bundled", "go": "github.com/projectdiscovery/dnsx/cmd/dnsx@latest", "source": "https://github.com/projectdiscovery/dnsx/releases", "license": "MIT" },
    "katana": { "tier": "bundled", "go": "github.com/projectdiscovery/katana/cmd/katana@latest", "source": "https://github.com/projectdiscovery/katana/releases", "license": "MIT" },
    "alterx": { "tier": "bundled", "go": "github.com/projectdiscovery/alterx/cmd/alterx@latest", "license": "MIT" },
    "notify": { "tier": "bundled", "go": "github.com/projectdiscovery/notify/cmd/notify@latest", "license": "MIT" },
    "uncover": { "tier": "bundled", "go": "github.com/projectdiscovery/uncover/cmd/uncover@latest", "license": "MIT" },
    "shuffledns": { "tier": "ondemand", "go": "github.com/projectdiscovery/shuffledns/cmd/shuffledns@latest", "note": "needs massdns", "license": "MIT" },
    "ffuf": { "tier": "bundled", "go": "github.com/ffuf/ffuf/v2@latest", "source": "https://github.com/ffuf/ffuf/releases", "license": "MIT" },
    "amass": { "tier": "ondemand", "choco": "amass", "go": "github.com/owasp-amass/amass/v4/...@master", "source": "https://github.com/owasp-amass/amass/releases", "license": "Apache-2.0" },
    "assetfinder": { "tier": "bundled", "go": "github.com/tomnomnom/assetfinder@latest", "license": "MIT" },
    "waybackurls": { "tier": "bundled", "go": "github.com/tomnomnom/waybackurls@latest", "license": "MIT" },
    "gowitness": { "tier": "ondemand", "go": "github.com/sensepost/gowitness@latest", "note": "needs Chrome/Chromium", "license": "GPL-3.0" },
    "cero": { "tier": "bundled", "go": "github.com/glebarez/cero@latest", "license": "MIT" },
    "gitleaks": { "tier": "bundled", "winget": "gitleaks.gitleaks", "choco": "gitleaks", "source": "https://github.com/gitleaks/gitleaks/releases", "license": "MIT" },
    "semgrep": { "tier": "ondemand", "pip": "semgrep", "license": "LGPL-2.1" },
    "trivy": { "tier": "bundled", "choco": "trivy", "scoop": "trivy", "source": "https://github.com/aquasecurity/trivy/releases", "license": "Apache-2.0" },
    "checkov": { "tier": "ondemand", "pip": "checkov", "license": "Apache-2.0" },
    "prowler": { "tier": "ondemand", "pip": "prowler", "license": "Apache-2.0" },
    "scoutsuite": { "tier": "ondemand", "pip": "scoutsuite", "license": "GPL-2.0" },
    "kube-hunter": { "tier": "ondemand", "pip": "kube-hunter", "license": "Apache-2.0" },
    "kubeaudit": { "tier": "ondemand", "go": "github.com/Shopify/kubeaudit@latest", "license": "MIT" },
    "kube-bench": { "tier": "ondemand", "source": "https://github.com/aquasecurity/kube-bench/releases", "license": "Apache-2.0" },
    "sslscan": { "tier": "ondemand", "choco": "sslscan", "source": "https://github.com/rbsec/sslscan/releases", "license": "GPL-3.0" },
    "sqlmap": { "tier": "ondemand", "pip": "sqlmap", "source": "https://github.com/sqlmapproject/sqlmap", "license": "GPL-2.0" },
    "commix": { "tier": "ondemand", "source": "https://github.com/commixproject/commix", "note": "git clone + python commix.py", "license": "GPL-3.0" },
    "arjun": { "tier": "ondemand", "pip": "arjun", "license": "AGPL-3.0" },
    "dalfox": { "tier": "ondemand", "go": "github.com/hahwul/dalfox/v2@latest", "license": "MIT" },
    "wpscan": { "tier": "ondemand", "gem": "wpscan", "note": "needs Ruby; API token for vuln data", "license": "custom (non-commercial)" },
    "nikto": { "tier": "ondemand", "source": "https://github.com/sullo/nikto", "note": "perl", "license": "GPL" },
    "smuggler": { "tier": "ondemand", "source": "https://github.com/defparam/smuggler", "note": "git clone + python", "license": "MIT" },
    "hashcat": { "tier": "ondemand", "choco": "hashcat", "note": "GPU recommended", "license": "MIT" },
    "hydra": { "tier": "ondemand", "note": "THC-Hydra; Windows build via cygwin or use WSL", "license": "AGPL-3.0" },
    "crackmapexec": { "tier": "ondemand", "pip": "crackmapexec", "note": "successor: netexec (pip install netexec)", "license": "BSD-2" },
    "bloodhound": { "tier": "ondemand", "note": "needs neo4j + SharpHound/BloodHound.py collector", "source": "https://github.com/BloodHoundAD/BloodHound", "license": "GPL-3.0" },
    "ghidra": { "tier": "ondemand", "source": "https://github.com/NationalSecurityAgency/ghidra/releases", "note": "needs a JDK; large (~400MB)", "license": "Apache-2.0" },
    "zap": { "tier": "ondemand", "choco": "zap", "note": "OWASP ZAP; needs Java", "license": "Apache-2.0" },
    "mobsf": { "tier": "ondemand", "note": "docker run opensecurity/mobile-security-framework-mobsf", "license": "GPL-3.0" },
    "metasploit": { "tier": "implant", "note": "isolated lab only; never bundle; official installer from rapid7", "license": "BSD-3 (framework)" },
    "burpsuite": { "tier": "commercial", "note": "user provides licensed install; do not bundle", "license": "commercial" },
    "nessus": { "tier": "commercial", "note": "Tenable; user provides; do not bundle", "license": "commercial" },
    "acunetix": { "tier": "commercial", "note": "user provides; do not bundle", "license": "commercial" },
    "nextjs-scanner": { "tier": "ondemand", "note": "project-specific; git clone from its repo", "license": "varies" },
    "shodan": { "tier": "api", "pip": "shodan", "env": "SHODAN_API_KEY", "note": "no scanning binary; queries Shodan's API", "license": "API ToS" },
    "virustotal": { "tier": "api", "env": "VT_API_KEY", "note": "vt-cli or REST API", "license": "API ToS" },
    "crtsh": { "tier": "api", "note": "queries https://crt.sh (no key)", "license": "public" }
  }
}
